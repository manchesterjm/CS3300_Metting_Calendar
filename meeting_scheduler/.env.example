# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive data

# Django Settings
# Generate new secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug Mode
# Set to False in production
DEBUG=False

# Allowed Hosts
# Comma-separated list of allowed domains
# Example: yourusername.pythonanywhere.com,yourdomain.com
ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Email Configuration
# Gmail SMTP settings - requires Gmail App Password (not regular password)
# To get app password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to "App passwords"
# 4. Generate password for "Mail" / "Other (Django App)"
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Admin Configuration (optional)
ADMIN_EMAIL=admin@example.com

# Database Configuration (optional - defaults to SQLite)
# If using PostgreSQL on another platform:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Custom Domain (if using)
# CUSTOM_DOMAIN=yourdomain.com
