# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive data
# IMPORTANT: .env should be listed in .gitignore

# Django Settings
# CRITICAL: Generate a NEW secret key for production - never use the example below
# Generate new secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# WARNING: The application will refuse to start if SECRET_KEY is not properly set
SECRET_KEY=your-secret-key-here-MUST-BE-CHANGED-IN-PRODUCTION

# Debug Mode
# SECURITY WARNING: MUST be False in production to prevent information leakage
# Setting DEBUG=True in production exposes:
# - Detailed error pages with stack traces
# - Internal application structure
# - Database query details
# - Environment variables
DEBUG=False

# Allowed Hosts
# IMPORTANT: Change this to match your actual domain(s)
# Format: Comma-separated list with no spaces
# Examples:
#   Single domain: ALLOWED_HOSTS=yourdomain.com
#   Multiple domains: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,yourusername.pythonanywhere.com
# WARNING: Using '*' (all hosts) in production is a security risk
ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Email Configuration
# Gmail SMTP settings - requires Gmail App Password (not regular password)
# To get app password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to "App passwords"
# 4. Generate password for "Mail" / "Other (Django App)"
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Admin Configuration (optional)
ADMIN_EMAIL=admin@example.com

# Database Configuration (optional - defaults to SQLite)
# If using PostgreSQL on another platform:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Custom Domain (if using)
# CUSTOM_DOMAIN=yourdomain.com
