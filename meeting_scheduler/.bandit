# Bandit configuration file for Django project
exclude_dirs:
  - '/venv/'
  - '/env/'
  - '/ENV/'
  - '/htmlcov/'
  - '/.hypothesis/'
  - '/.pytest_cache/'
  - '/migrations/'

# Skip certain tests that are Django-specific or not applicable
skips:
  - B101  # assert_used - appropriate in tests
  - B601  # parameterized shell - will review manually

# Tests to run (security checks)
tests:
  - B201
  - B301
  - B302
  - B303
  - B304
  - B305
  - B306
  - B307
  - B308
  - B310
  - B311
  - B312
  - B313
  - B314
  - B315
  - B316
  - B317
  - B318
  - B319
  - B320
  - B321
  - B323
  - B324
  - B501
